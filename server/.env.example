# Copy to .env and edit
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/dineflow
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d

# Comma separated list of allowed front-end origins (used in production)
CLIENT_ORIGIN=http://localhost:5173

# Create the super admin + demo restaurant automatically on first start
SEED_ON_START=true
ADMIN_EMAIL=admin@dineflow.com
ADMIN_PASSWORD=Admin@123
